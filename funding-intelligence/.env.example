# === Copiază în .env și completează ===

# --- Bază de date ---
POSTGRES_USER=funding
POSTGRES_PASSWORD=changeme_local
POSTGRES_DB=funding
# DATABASE_URL e construit din variabilele de mai sus în config.py;
# îl poți suprascrie explicit dacă rulezi Postgres în afara compose.
DATABASE_URL=postgresql+psycopg://funding:changeme_local@db:5432/funding

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- LLM ---
# Cheia Anthropic. Pentru extracție folosim un model ieftin (Haiku) la MVP.
ANTHROPIC_API_KEY=
LLM_EXTRACTION_MODEL=claude-haiku-4-5-20251001

# --- Auth (MVP: un singur token static, ești singurul utilizator) ---
# Generează ceva random: `openssl rand -hex 32`
API_STATIC_TOKEN=changeme_generate_a_random_token

# --- Storage local (înlocuiește MinIO/S3 la MVP) ---
STORAGE_DIR=/app/data/storage

# --- Comportament ---
LOG_LEVEL=INFO
SCRAPER_RATE_LIMIT_SECONDS=3
