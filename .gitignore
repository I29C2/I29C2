# .gitignore
# BetBot AI – Git ignore rules for Python, Node.js, and Docker

# ============================================================
# Environment files (NEVER commit secrets)
# ============================================================
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.p12

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg
MANIFEST
.eggs/
*.whl
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
.env/
.venv*/

# Type checking
.mypy_cache/
.pytype/
.pyre/
.dmypy.json

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.coveragerc
nosetests.xml
test-results/
junit*.xml

# Jupyter Notebooks
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# Celery
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# Logs
*.log
logs/
*.log.*

# ============================================================
# Database files (local dev only)
# ============================================================
*.db
*.sqlite
*.sqlite3
# Exception: keep test DB config but not runtime files
!test_*.db.example

# Alembic
alembic/versions/__pycache__/

# ============================================================
# ML model artifacts
# ============================================================
ml_models/*.pkl
ml_models/*.joblib
ml_models/*.h5
ml_models/*.pt
ml_models/*.pth
ml_models/*.onnx
ml_models/*.bin
# Keep the directory and any README/config inside
!ml_models/.gitkeep
!ml_models/README.md

# ============================================================
# Node.js / Frontend
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
.pnpm-debug.log*
package-lock.json.bak

# Next.js
.next/
out/
.vercel/
.turbo/

# Nuxt / Vue
.nuxt/

# Build outputs
dist/
build/

# Environment (Next.js specific)
.env*.local

# TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# Storybook
storybook-static/

# ============================================================
# Docker
# ============================================================
# Don't ignore docker-compose overrides that exist in the repo
# but ignore local developer overrides
docker-compose.override.yml
docker-compose.local.yml

# ============================================================
# IDE / Editor
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.directory

# JetBrains
*.iml
*.iws
*.ipr
.idea/

# Vim
Session.vim
.netrwhist

# ============================================================
# OS generated
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ============================================================
# Miscellaneous
# ============================================================
*.bak
*.orig
*.tmp
*.temp
dump.rdb
*.pid

# Secrets and credentials that should never be committed
credentials.json
service-account*.json
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub
